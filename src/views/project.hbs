    <div class="container">
  <div class="atas">

    <div class="container form-container">
      <h2 class="text-center fw-bold mb-5">ADD MY PROJECT</h2>

      <form action="/project" method="post">
  <label class="fw-semibold">Project Name</label>
  <input name="project_name" type="text" class="form-control mb-3" placeholder="Name">

  <label class="fw-semibold">Description</label>
  <textarea name="description" class="form-control mb-3" rows="4"></textarea>
  
  <div class="row mb-3 g-3">
    <div class="col-md-6">
      <label class="fw-semibold">Start Date</label>
      <input type="date" name="start_date" class="form-control">
    </div>

    <div class="col-md-6">
      <label class="fw-semibold">End Date</label>
      <input type="date" name="end_date" class="form-control">
    </div>
  </div>

  <label class="fw-semibold">Technologies</label>
  <div class="row mb-3">
    <div class="col-6">
      <input type="checkbox" name="tech[]" value="Node Js" class="form-check-input">
      Node Js
    </div>
    <div class="col-6">
      <input type="checkbox" name="tech[]" value="React Js" class="form-check-input">
      React Js
    </div>
    <div class="col-6">
      <input type="checkbox" name="tech[]" value="Next Js" class="form-check-input">
      Next Js
    </div>
    <div class="col-6">
      <input type="checkbox" name="tech[]" value="Type Script" class="form-check-input">
      Type Script
    </div>
  </div>

  <label class="fw-semibold">Upload gambar</label><br>
  <input type="file" name="image" class="form-control mb-5">

  <button type="submit" class="btn btn-dark-round text-white mx-auto d-block">
    <section class="submit">Submit</section>
  </button>
</form>


    </div>
    </div>

    <div class="bawah">

    <div id="detailView" class="container py-5" style="display:none;"></div>

    <div class="container py-5">
     <h2 class="fw-bold text-center mb-5">MY PROJECT</h2>

    <div class="row g-4">
    {{#each projects}}
    <div class="col-md-4">
      <div class="card p-3 shadow">
        <h5 class="fw-bold">{{this.name}}</h5>
        <p>ID: {{this.id}}</p>
      </div>
    </div>
    {{/each}}
    </div>


      <div class="row g-4" id="projectList"></div>
    </div>
  </div>
</div>

<script src="/script.js"></script>
</body>

  </div>
</body>
</html>